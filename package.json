{
  "name": "narada-chat-widget-examples",
  "private": true,
  "workspaces": [
    "Narada_SDK",
    "CLIENT_USER/ANGULARCLIENT",
    "CLIENT_USER/NORMALHTMLCLIENT",
    "CLIENT_USER/REACTCLIENT",
    "CLIENT_USER/VUECLIENT",
    "stitch_narada_chat_widget_sdk"
  ],
  "scripts": {
    "build:sdk": "npm run build --workspace=@narada/ai-chat-widget",
    "build:clients": "npm run build --workspace=normal-html-client && npm run build --workspace=react-client && npm run build --workspace=vue-client && npm run build --workspace=angular-client",
    "build:portal": "npm run build --workspace=narada-integration-portal",
    "build": "npm run build:sdk && npm run build:clients && npm run build:portal",
    "dev:html": "npm run dev --workspace=normal-html-client",
    "dev:react": "npm run dev --workspace=react-client",
    "dev:vue": "npm run dev --workspace=vue-client",
    "dev:angular": "npm run start --workspace=angular-client",
    "dev:portal": "npm run dev --workspace=narada-integration-portal"
  }
}
